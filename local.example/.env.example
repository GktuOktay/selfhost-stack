# selfhost-stack: makineye özel ayarlar. Bu dosya şablondur (git'te).
# `./stack init` bunu local/.env olarak üretir: __GENERATE__ rastgele secret olur,
# diğer değerler aynen kopyalanır. Var olan anahtarlar asla değiştirilmez.
# Satır biçimi yalnız KEY=değer (export yok, tırnak yok, $ yok).

# --- Penpot ---
PENPOT_PORT=8702
PENPOT_SECRET_KEY=__GENERATE__
PENPOT_DB_PASSWORD=__GENERATE__
# İsteğe bağlı: ilk profil için geçici enable-prepl-server (README), sonra boşalt.
PENPOT_EXTRA_FLAGS=
