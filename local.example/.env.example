# selfhost-stack: makineye özel ayarlar. Bu dosya şablondur (git'te).
# `./stack init` bunu local/.env olarak üretir: __GENERATE__ rastgele secret olur,
# diğer değerler aynen kopyalanır. Var olan anahtarlar asla değiştirilmez.
# Satır biçimi yalnız KEY=değer (export yok, tırnak yok, $ yok).

# --- BookStack ---
BOOKSTACK_PORT=8701
BOOKSTACK_DB_PASSWORD=__GENERATE__
BOOKSTACK_DB_ROOT_PASSWORD=__GENERATE__
BOOKSTACK_APP_KEY=__GENERATE__
BOOKSTACK_ADMIN_EMAIL=admin@selfhost.local
BOOKSTACK_ADMIN_PASSWORD=__GENERATE__

# --- Penpot ---
PENPOT_PORT=8702
PENPOT_SECRET_KEY=__GENERATE__
PENPOT_DB_PASSWORD=__GENERATE__
# İsteğe bağlı: ilk profil için geçici enable-prepl-server (README), sonra boşalt.
PENPOT_EXTRA_FLAGS=

# --- Plane ---
PLANE_PORT=8703
PLANE_SECRET_KEY=__GENERATE__
PLANE_LIVE_SECRET_KEY=__GENERATE__
PLANE_DB_PASSWORD=__GENERATE__
PLANE_RABBITMQ_PASSWORD=__GENERATE__
PLANE_STORAGE_ACCESS_KEY=__GENERATE__
PLANE_STORAGE_SECRET_KEY=__GENERATE__
